# Supabase — 새 프로젝트를 만들지 않고 기존 z-labs 공용 프로젝트를 쓴다.
# 테이블은 wooz_trip_ 프리픽스로 분리 → src/lib/tables.js
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 서버 전용 (공유 링크 조회·관리자·이벤트 기록). 브라우저에 노출 금지
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 이 이메일로 로그인한 계정만 /admin 접근
ADMIN_EMAIL=you@example.com

# 카카오맵 JS 키 (없으면 간이 SVG 지도로 표시)
NEXT_PUBLIC_KAKAO_MAP_KEY=

# 서비스명 (미정 — 정해지면 여기만 바꾼다)
NEXT_PUBLIC_SERVICE_NAME=
# 공유 미리보기·사이트맵 기준 주소 (비우면 https://trip.z-labs.kr)
NEXT_PUBLIC_SITE_URL=
# 이용약관·개인정보처리방침에 나오는 운영자 이름, 문의 이메일, 시행일(YYYY-MM-DD). 비어 있으면 「정식 오픈 전 초안」으로 보인다
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_POLICY_DATE=

# 한국관광공사 TourAPI (공공데이터포털 일반 인증키 Decoding). 장소 수집 스크립트 전용, 서비스 화면은 안 씀
TOURAPI_SERVICE_KEY=
# 무장애 여행 정보 키 (다른 키를 받았을 때만. 비우면 위 키를 같이 씀)
TOURAPI_WITH_SERVICE_KEY=

# 카카오 REST API 키 (developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키). 블로그 검색(스크립트) + 숙소·장소 검색(서비스 서버). Vercel 에도 넣는다. 브라우저에 노출 금지
KAKAO_REST_API_KEY=
# 카카오모빌리티 길찾기 하루 호출 상한 (무료 10,000건/일, 비우면 9000)
TRAVEL_DAILY_LIMIT=
